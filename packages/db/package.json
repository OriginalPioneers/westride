{
  "name": "@westride/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./mentorship": "./src/mentorship.ts",
    "./ideas": "./src/ideas.ts",
    "./idea-factory": "./src/idea-factory.ts",
    "./countries": "./src/country-catalog.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "bun src/drizzle-cli.ts migrate --target production",
    "db:seed": "bun src/seed.ts",
    "db:seed:production": "bun src/seed.ts --target production",
    "db:reset": "bun src/reset.ts",
    "db:reset:production": "bun src/reset.ts --target production"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  }
}
