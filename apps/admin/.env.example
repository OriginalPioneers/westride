# WeStride Admin. Copy this file to apps/admin/.env.
#
# The admin portal shares the WeStride database and the WeStride Clerk
# application with apps/web, so DATABASE_URL and the Clerk keys are the same
# values as in apps/web/.env. Members sign in with their normal WeStride
# account; only accounts that carry the admin role get past the sign-in page.
#
# Granting the role, in the Clerk Dashboard: Users → pick the member →
# Metadata → Public → add {"role": "admin"} (or {"roles": ["admin"]}). An
# admin can also grant or revoke it from the Users page of this portal.
#
# Optional, recommended: Sessions → Customize session token → add
#   {"metadata": "{{user.public_metadata}}"}
# so the role travels in the session and the portal does not have to ask
# Clerk's API for it on every request.

# Database - Postgres - Neon (same as apps/web)
DATABASE_URL="postgresql://neondb_owner:"

# Authentication - Clerk (same application as apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"

# The value of publicMetadata.role (or an entry in publicMetadata.roles)
# that opens the portal. Default: admin.
ADMIN_ROLE=""

# Public origin of the member-facing site, for "open on WeStride" links.
# Default: https://www.westride.org. Use http://localhost:3000 in development.
NEXT_PUBLIC_WESTRIDE_SITE_URL=""
