# Base URL of the WeStride API. Not a secret. Defaults to https://api.westride.org
# when unset, so production needs no value. Point it at the local API for dev.
WESTRIDE_API_URL="http://localhost:3001"

# Clerk publishable key (same instance as apps/web). Not a secret. Used to tell
# MCP clients which authorization server to sign members in with; token
# verification itself happens in the API. Without it, clients get a 401 with no
# way to sign in.
CLERK_PUBLISHABLE_KEY="pk_test_"

# Local port. Production serves this app at https://mcp.westride.org/mcp
PORT=3002
