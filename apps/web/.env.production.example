# Production overlay for the web app and database scripts.
#
# Copy to apps/web/.env.production and set the production database URL.
# apps/web/.env is the development default for `next dev` and `bun run db:*`.
# This file is used by `next build`, `next start`, and `bun run db:*:production`.
# Keys set here override the same keys in apps/web/.env. Anything you leave
# out keeps the development value.
#
# Full reset (wipe, migrate, reseed catalogs):
#   bun run db:reset -- --yes
#   bun run db:reset:production -- --yes

DATABASE_URL="postgresql://neondb_owner:"

# Optional direct connection. Migrations already rewrite a "-pooler" host.
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:"

# GitHub - production GitHub App. See .env.example for how to set it up.
# GITHUB_APP_SLUG=""
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_APP_PRIVATE_KEY=""
# GITHUB_TOKEN_ENCRYPTION_KEY=""
# GITHUB_APP_HOME_INSTALLATION_ID=""
