# Development is the default. Copy this file to apps/web/.env.
# Production overrides belong in apps/web/.env.production
# (see .env.production.example). `next dev` and `bun run db:*` use this file.
# `next build`, `next start`, and `bun run db:*:production` apply the overlay.
#
# Full database reset (wipe, migrate, reseed catalogs):
#   bun run db:reset -- --yes
#   bun run db:reset:production -- --yes

# Database - Postgres - Neon
DATABASE_URL="postgresql://neondb_owner:"

# Authentication - Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Storage - Blob - Vercel
BLOB_PUBLIC_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_PUBLIC_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BLOB_PRIVATE_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_PRIVATE_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email - Resend
# Claim requests for imported ideas go to RESEND_TO_EMAIL, which may list
# several addresses separated by commas. Each email carries a one-time review
# link, so only people who should decide claims belong on it. Leave the key
# blank to turn requests off; claiming through GitHub still works.
RESEND_API_KEY="re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Name <email_to_send@domain.com>"
RESEND_TO_EMAIL="first@domain.com, second@domain.com"

# AI - Meta Model API (Idea Workshop, voice dictation)
# WeStride never calls Muse with its own key: members connect their own Meta
# account in Settings (or the Idea Workshop), and their key is kept encrypted
# on their WeStride account and used only for requests they make. The same
# key pays for the microphone button on long text fields (Muse Voice
# Transcribe, $0.18 per hour of audio).
# "Connect your Meta account" uses the OAuth device flow that Meta's Muse Code
# CLI uses (auth.meta.com/oidc/device). Meta does not document it for third
# parties, so it is optional: leave this blank and members paste an API key
# from https://dev.meta.ai/ instead. Muse Code's public client id is
# 1031625952748946.
META_DEVICE_CLIENT_ID=""
# Encrypts members' Meta keys at rest. Required to connect Meta at all.
# 32 random bytes, base64 (same command as GITHUB_TOKEN_ENCRYPTION_KEY below).
META_TOKEN_ENCRYPTION_KEY=""

# GitHub - the WeStride GitHub App
# Create the app under the WeStrideOrg organization (Settings → Developer
# settings → GitHub Apps) so commits WeStride writes come from its bot.
# Use one app per environment: the setup URL can only point at one host.
#   Callback URL and Setup URL: <origin>/integrations/github/callback
#     (tick "Redirect on update"; leave "Request user authorization (OAuth)
#     during installation" off; keep "Expire user authorization tokens" on)
#   Webhook: inactive
#   Repository permissions: Contents read & write, Metadata read,
#     Pull requests read & write (agents open pull requests),
#     Administration read & write (only needed to create repositories)
#   Adding a permission later: change it in the app's settings, then accept
#   the new permissions on each installation (GitHub emails the owner).
#   Where can it be installed: Any account
# Leave these blank to turn GitHub off. Public repos still import without it.
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# The downloaded .pem. One line with \n escapes is fine.
GITHUB_APP_PRIVATE_KEY=""
# Encrypts members' GitHub tokens at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=""
# Optional. The app's installation id on WeStrideOrg (the number at the end of
# github.com/organizations/WeStrideOrg/settings/installations/<id>). Lets public
# repos import at the app's rate limit instead of GitHub's anonymous one.
GITHUB_APP_HOME_INSTALLATION_ID=""
# Optional. Overrides the author on commits WeStride writes. Without it the
# author is the app's bot, e.g. westride[bot].
GITHUB_COMMIT_AUTHOR_NAME=""
GITHUB_COMMIT_AUTHOR_EMAIL=""

# Vercel - members' own Vercel accounts host the Vercel Sandbox microVMs
# (https://vercel.com/docs/vercel-sandbox) that Muse Code agents run in, so
# Vercel bills them and never WeStride. Members connect in Settings, then pick
# the team and project their sandboxes run under.
# "Sign in with Vercel" uses the OAuth device flow that Vercel's CLI and Sandbox
# SDK use (vercel.com/.well-known/openid-configuration). Vercel does not
# document it for third parties, so it is optional: leave this blank and members
# paste an access token from https://vercel.com/account/settings/tokens instead.
# The Vercel CLI's public client id is cl_HYyOPBNtFMfHhaUn9L4QPfTZz6TP47bp.
VERCEL_DEVICE_CLIENT_ID=""
# Encrypts members' Vercel tokens at rest. Required to connect Vercel at all.
# 32 random bytes, base64 (same command as GITHUB_TOKEN_ENCRYPTION_KEY above).
VERCEL_TOKEN_ENCRYPTION_KEY=""

# Modal - the other host members can bring for their sandboxes. A member
# pastes an API token (id + secret) from https://modal.com/settings/tokens;
# their Muse Code sandboxes then run as Modal Sandboxes
# (https://modal.com/docs/guide/sandboxes) in their workspace, so Modal bills
# them and never WeStride. Modal has no sign-in flow for third parties, so
# pasting is the only way to connect. This key encrypts those tokens at rest
# and is required to connect Modal at all. 32 random bytes, base64.
# A Muse Code run needs one of VERCEL_TOKEN_ENCRYPTION_KEY, this key, or
# WeStride Cloud compute (below).
MODAL_TOKEN_ENCRYPTION_KEY=""

# Project Factory - Muse Code agents run in sandboxes on the member's Vercel or
# Modal account (above), or on WeStride Cloud, never on this server. Leave the
# callback URL blank to turn agent runs off; planning, tickets, and GitHub
# activity still work.
#
# Public origin of this server. The sandbox posts its work log to
# <origin>/integrations/muse-code/events, so localhost needs a tunnel URL.
BUILD_RUNNER_CALLBACK_URL=""
# Optional. Sandbox lifetime in minutes (default 45, max 300), vCPUs (default 2),
# and how many agents may run at once per project (default 2).
BUILD_RUNNER_SANDBOX_TIMEOUT_MINUTES=""
BUILD_RUNNER_SANDBOX_VCPUS=""
BUILD_RUNNER_MAX_ACTIVE_RUNS=""

# Agent Studio - standing agents with a backlog and a schedule. Agents with a
# repository reuse the Muse Code runner above; without one they write reports
# through the Model API. Scheduled work is run by GET
# /integrations/agents/schedule, which Vercel Cron calls every 15 minutes
# (apps/web/vercel.json) with "Authorization: Bearer $CRON_SECRET". Any other
# scheduler can call it the same way. Leave blank to close the route; due work
# then runs when someone opens Agent Studio. Note Vercel's Hobby plan only
# runs cron jobs once a day; see docs/agent-studio.md.
CRON_SECRET=""

# WeStride Cloud - members without a Meta, Vercel, or Modal account fund a
# balance and run Muse and sandboxes on WeStride's own accounts instead. Each part is
# optional; leave it blank and that part of WeStride Cloud is not offered.
# Members can still redeem codes (bun run cloud:code) with nothing set.
# See docs/westride-cloud.md.
#
# Meta AI: an API key from WeStride's own https://dev.meta.ai/ account. Every
# Muse call made through WeStride Cloud uses it and is charged to the member's
# balance at Meta's list price plus WESTRIDE_CLOUD_AI_MARKUP_PERCENT.
WESTRIDE_CLOUD_META_API_KEY=""
# Compute: a Modal (https://modal.com) token from WeStride's OWN workspace
# (Settings → API Tokens); members' own Modal tokens are a separate thing,
# see MODAL_TOKEN_ENCRYPTION_KEY above. Muse Code sandboxes for WeStride Cloud
# members run as Modal Sandboxes (https://modal.com/docs/guide/sandboxes) in
# this environment, under an app WeStride creates on first use
# (WESTRIDE_CLOUD_MODAL_APP_NAME, default westride-cloud). The BUILD_RUNNER_*
# settings above apply to them too.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
MODAL_ENVIRONMENT=""
WESTRIDE_CLOUD_MODAL_APP_NAME=""
# Payments: Stripe (https://dashboard.stripe.com/apikeys). Adding funds uses
# Stripe Checkout, so WeStride never sees a card. Add a webhook endpoint at
# <origin>/integrations/stripe/webhook for the events checkout.session.completed
# and checkout.session.async_payment_succeeded, and put its signing secret in
# STRIPE_WEBHOOK_SECRET; without it, balances are only credited when the member
# returns from Stripe. For local development: stripe listen --forward-to
# localhost:3000/integrations/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional prices. Markup on Meta's list prices in percent (default 20) and
# what one vCPU-hour of sandbox time costs the member in cents (default 20).
WESTRIDE_CLOUD_AI_MARKUP_PERCENT=""
WESTRIDE_CLOUD_COMPUTE_VCPU_HOUR_CENTS=""

# Chat - members link Slack, Discord, and WhatsApp in Settings and chat with
# WeStride there. Commands read the academy from the public WeStride API.
# Leave a platform's values blank to turn it off.
#
# Base URL of the WeStride API. Defaults to https://api.westride.org.
WESTRIDE_API_URL=""

# Slack - create an app at https://api.slack.com/apps
#   OAuth & Permissions → Redirect URL: <origin>/integrations/slack/callback
#     (Slack only accepts https, so use a tunnel for local development)
#   Slash Commands → /westride, Request URL: <origin>/integrations/slack/commands
#   Install the app in each workspace where members should use /westride.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# Discord - create an application at https://discord.com/developers/applications
#   OAuth2 → Redirects: <origin>/integrations/discord/callback
#   Installation → Installation Contexts: tick User Install and Guild Install
#   General Information → Interactions Endpoint URL:
#     <origin>/integrations/discord/interactions
#   Then register the /westride command: bun run discord:register
DISCORD_APPLICATION_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_PUBLIC_KEY=""
# Only used by `bun run discord:register`.
DISCORD_BOT_TOKEN=""

# WhatsApp - WhatsApp Cloud API on a Meta app (https://developers.facebook.com/apps)
#   WhatsApp → Configuration → Callback URL: <origin>/integrations/whatsapp/webhook
#     Verify token: WHATSAPP_VERIFY_TOKEN. Subscribe to the "messages" field.
# The number members message, with country code, e.g. 15551234567.
WHATSAPP_PHONE_NUMBER=""
WHATSAPP_PHONE_NUMBER_ID=""
# A permanent System User token with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=""
# App settings → Basic → App secret. Verifies that webhooks come from Meta.
WHATSAPP_APP_SECRET=""
# Any random string. Meta echoes it back when you save the callback URL.
WHATSAPP_VERIFY_TOKEN=""