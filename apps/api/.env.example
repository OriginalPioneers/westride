# Database - Postgres - Neon (same database as apps/web)
DATABASE_URL="postgresql://neondb_owner:"

# Clerk - the same instance apps/web and apps/mobile sign people in with.
# The API verifies session tokens, WeStride API keys, and OAuth access tokens
# against it and looks up member names. Without these every request is treated
# as a signed-out visitor.
CLERK_SECRET_KEY="sk_test_"
CLERK_PUBLISHABLE_KEY="pk_test_"
# Optional. Comma-separated origins allowed to mint session tokens.
# CLERK_AUTHORIZED_PARTIES="https://westride.org,http://localhost:3000"

# Local port. Production serves this app at https://api.westride.org
PORT=3001
