# Database - Postgres - Neon (same database as apps/web)
DATABASE_URL="postgresql://neondb_owner:"

# Clerk - the same instance apps/web signs people in with. The API verifies
# WeStride API keys and OAuth access tokens against it and looks up member
# names. Without these every request is treated as a signed-out visitor.
CLERK_SECRET_KEY="sk_test_"
CLERK_PUBLISHABLE_KEY="pk_test_"

# Local port. Production serves this app at https://api.westride.org
PORT=3001
