{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:explorer": "bun scripts/build-explorer.ts",
    "build": "bun run build:explorer && bun build src/app.ts --target=node --format=esm --outdir=dist --external hono --external 'hono/*'",
    "start": "bun run build:explorer && bun src/index.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p explorer"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-stone": "^0.7.4",
    "@heroicons/react": "^2.2.0",
    "@hono/zod-openapi": "^1.6.3",
    "@westride/api-client": "workspace:*",
    "@westride/db": "workspace:*",
    "hono": "^4.13.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
